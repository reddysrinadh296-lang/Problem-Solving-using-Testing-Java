class Solution {
    public List<String> findAndReplacePattern(String[] words, String pattern) {
        List<String> result = new ArrayList<>();

        for (String word : words) {
            int[] wMap = new int[26];
            int[] pMap = new int[26];

            Arrays.fill(wMap, -1);
            Arrays.fill(pMap, -1);

            boolean match = true;

            for (int i = 0; i < pattern.length(); i++) {
                int w = word.charAt(i) - 'a';
                int p = pattern.charAt(i) - 'a';

                if (wMap[w] == -1 && pMap[p] == -1) {
                    wMap[w] = p;
                    pMap[p] = w;
                } else if (wMap[w] != p || pMap[p] != w) {
                    match = false;
                    break;
                }
            }

            if (match) {
                result.add(word);
            }
        }

        return result;
    }
}
