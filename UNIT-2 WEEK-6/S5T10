import java.io.*;
import java.util.*;
import static java.util.stream.Collectors.joining;

class Result {

    static int[] odd;
    static int[] even;
    static int[][] sparseOdd;
    static int[][] sparseEven;
    static int[] log;

    public static List<Integer> circularPalindromes(String s) {
        int n = s.length();
        int len = 2 * n;

        String doubled = s + s;
        char[] a = doubled.toCharArray();

        odd = new int[len];
        even = new int[len];

        buildManacher(a);
        buildSparseTables(len);

        List<Integer> result = new ArrayList<>();

        for (int start = 0; start < n; start++) {

            int low = 1;
            int high = (n + 1) / 2;
            int bestOdd = 1;

            while (low <= high) {
                int k = (low + high) / 2;

                int left = start + k - 1;
                int right = start + n - k;

                if (left <= right && rangeMaxOdd(left, right) >= k) {
                    bestOdd = 2 * k - 1;
                    low = k + 1;
                } else {
                    high = k - 1;
                }
            }

            int bestEven = 0;

            low = 1;
            high = n / 2;

            while (low <= high) {
                int k = (low + high) / 2;

                int left = start + k;
                int right = start + n - k;

                if (left <= right && rangeMaxEven(left, right) >= k) {
                    bestEven = 2 * k;
                    low = k + 1;
                } else {
                    high = k - 1;
                }
            }

            result.add(Math.max(bestOdd, bestEven));
        }

        return result;
    }

    private static void buildManacher(char[] a) {
        int n = a.length;

        int l = 0;
        int r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 : Math.min(odd[l + r - i], r - i + 1);

            while (i - k >= 0 &&
                   i + k < n &&
                   a[i - k] == a[i + k]) {
                k++;
            }

            odd[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        l = 0;
        r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 0 :
                    Math.min(even[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 &&
                   i + k < n &&
                   a[i - k - 1] == a[i + k]) {
                k++;
            }

            even[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }
    }

    private static void buildSparseTables(int n) {
        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int levels = log[n] + 1;

        sparseOdd = new int[levels][n];
        sparseEven = new int[levels][n];

        for (int i = 0; i < n; i++) {
            sparseOdd[0][i] = odd[i];
            sparseEven[0][i] = even[i];
        }

        for (int j = 1; j < levels; j++) {
            int length = 1 << j;
            int half = length >> 1;

            for (int i = 0; i + length <= n; i++) {
                sparseOdd[j][i] =
                        Math.max(sparseOdd[j - 1][i],
                                 sparseOdd[j - 1][i + half]);

                sparseEven[j][i] =
                        Math.max(sparseEven[j - 1][i],
                                 sparseEven[j - 1][i + half]);
            }
        }
    }

    private static int rangeMaxOdd(int left, int right) {
        if (left > right) {
            return 0;
        }

        int length = right - left + 1;
        int j = log[length];

        return Math.max(
                sparseOdd[j][left],
                sparseOdd[j][right - (1 << j) + 1]
        );
    }

    private static int rangeMaxEven(int left, int right) {
        if (left > right) {
            return 0;
        }

        int length = right - left + 1;
        int j = log[length];

        return Math.max(
                sparseEven[j][left],
                sparseEven[j][right - (1 << j) + 1]
        );
    }
}

public class Solution {

    public static void main(String[] args) throws IOException {

        BufferedReader bufferedReader =
                new BufferedReader(
                        new InputStreamReader(System.in)
                );

        BufferedWriter bufferedWriter =
                new BufferedWriter(
                        new FileWriter(System.getenv("OUTPUT_PATH"))
                );

        int n = Integer.parseInt(
                bufferedReader.readLine().trim()
        );

        String s = bufferedReader.readLine();

        List<Integer> result =
                Result.circularPalindromes(s);

        bufferedWriter.write(
                result.stream()
                        .map(Object::toString)
                        .collect(joining("\n"))
                        + "\n"
        );

        bufferedReader.close();
        bufferedWriter.close();
    }
}
